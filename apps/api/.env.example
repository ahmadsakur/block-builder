# Copy to .env and fill in. Schema lives in src/env.ts.
# Daily dev: local Postgres, Mailpit from `podman compose up -d`, files on disk.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/block_builder

# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin the browser uses. The web app proxies /api/* here, so this is the web URL.
BETTER_AUTH_URL=http://localhost:3000

PORT=3001

# SMTP. Mailpit catches everything in dev: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Block Builder <no-reply@localhost>

# File storage. local writes under STORAGE_DIR; s3 talks to any S3-compatible service
# (RustFS: podman compose --profile s3 up -d, console http://localhost:9001). Leave S3_ENDPOINT empty for AWS.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=block-builder
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

# The single root user, created by `pnpm --filter @block-builder/api db:seed`.
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=
ROOT_NAME=Root

# Dev only: `db:seed` also creates free@demo.local and pro@demo.local with DEMO_PASSWORD.
# Never turn this on in production.
SEED_DEMO_USERS=false
DEMO_PASSWORD=demo-password
