{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/build",
      "!**/public",
      "!apps/api/drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "plugins": ["./lint/no-raw-colors.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/env.ts",
        "apps/api/src/**",
        "!apps/api/src/env.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/components/_ui/**",
        "apps/web/src/components/dashboardblocks/**",
        "apps/web/src/lib/dashboardblocks/**"
      ],
      "linter": {
        "rules": {
          "preset": "none"
        },
        "domains": {
          "next": "none",
          "react": "none"
        }
      }
    },
    {
      "includes": [".claude/hooks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
