language js

or {
  JsStringLiteralExpression(),
  JsxString(),
  JsTemplateChunkElement()
} as $text where {
  $text <: or {
    r"(?s).*\b(?:text|bg|border|fill|stroke|ring|outline|decoration|from|via|to|shadow|caret|accent|divide|placeholder)-(?:red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|slate|gray|zinc|neutral|stone)-\d{2,3}\b.*",
    r"(?s).*\b(?:text|bg|border|fill|stroke|ring|outline|decoration|from|via|to|shadow|caret|accent|divide|placeholder)-(?:black|white)\b.*",
    r"(?s).*--color-(?:red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|slate|gray|zinc|neutral|stone)-\d{2,3}\b.*",
    r"(?s).*(?:^|[\s\[(:,'`\x22])#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})(?:$|[\s\])/,;'`\x22]).*",
    r"(?s).*\b(?:rgba?|hsla?|oklch|oklab|lab|lch|hwb)\(.*"
  },
  register_diagnostic(span=$text, message="Raw color. Use a design token from globals.css instead: text-success, bg-destructive/10, bg-overlay/50, var(--color-chart-2).")
}
