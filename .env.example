# Copy to .env.local and fill in. Schema lives in src/env.ts.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project: `pnpm exec supabase projects api-keys --project-ref <ref>`
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# CLI only (db push, link). Never read by the app.
SUPABASE_DB_PASSWORD=
